{
  "manifest_version": 3,
  "name": "ProofPipe",
  "version": "0.9.3",
  "key": "",
  "minimum_chrome_version": "116",
  "description": "Drag your ProofPipe captures into any chat, on any website.",
  "permissions": ["alarms", "contextMenus", "scripting", "offscreen", "tabs", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["toPng.js", "discovery.js", "paste-logic.js", "files.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "ProofPipe" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon.png" }
}
