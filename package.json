{
  "name": "proofpipe",
  "version": "1.24.0",
  "description": "Phone photo (and text) to PC, one tap — for pasting into AI chats",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --require ./scripts/threadpool.cjs server.js",
    "daemon": "node scripts/daemon.js",
    "build": "eslint .",
    "icons": "node scripts/gen-icons.js",
    "gen-cert": "node scripts/gen-cert.js",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1"
  }
}
